<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_bg"
        android:contentDescription="Album Artwork" />

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="32dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_shuffle"
            android:contentDescription="Shuffle" />

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="32dp"
            android:layout_height="36dp"
            android:layout_marginLeft="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="32dp"
            android:layout_height="36dp"
            android:layout_marginLeft="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_meta_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/widget_album_art"
        android:layout_toLeftOf="@+id/widget_controls"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music Studio"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to listen"
            android:textColor="#FF9EA7B8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>